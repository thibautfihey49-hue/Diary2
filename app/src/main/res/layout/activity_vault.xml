<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_aurora_blur">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="#B315151F" app:strokeWidth="1dp" app:strokeColor="#22FFFFFF" app:cardElevation="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
                    android:text="‹" android:textSize="20sp" style="@style/Widget.Material3.Button.IconButton" android:insetTop="0dp" android:insetBottom="0dp"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="🌙 COFFRE PRIVE" android:textColor="#FFD700" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnEffacer"
                    android:layout_width="wrap_content" android:layout_height="40dp" android:text="Effacer" style="@style/Widget.Material3.Button.TonalButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:text="CONTACTS" android:textColor="#666" android:textSize="11sp" android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/contactsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <EditText android:id="@+id/etContactName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:hint="Nom" android:background="@drawable/bg_glass_input" android:textColor="#FFF" android:paddingHorizontal="16dp"/>
            <EditText android:id="@+id/etContactNumber" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:hint="Numéro" android:background="@drawable/bg_glass_input" android:textColor="#FFF" android:paddingHorizontal="16dp" android:layout_marginStart="8dp" android:inputType="phone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddContact" android:layout_width="56dp" android:layout_height="56dp"
                android:text="+" android:textSize="22sp" style="@style/Widget.Material3.Button" android:layout_marginStart="8dp" app:cornerRadius="28dp"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="20dp" app:cardBackgroundColor="#9915151F" app:strokeColor="#22FF69B4" app:strokeWidth="1dp" app:cardElevation="16dp" android:layout_marginTop="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <EditText android:id="@+id/etDestNumber" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="Numéro" android:textColor="#FFF" android:background="@drawable/bg_glass_input" android:paddingHorizontal="16dp"/>
                <EditText android:id="@+id/etMessage" android:layout_width="match_parent" android:layout_height="100dp"
                    android:hint="Message" android:textColor="#FFF" android:background="@drawable/bg_glass_input" android:padding="12dp" android:gravity="top" android:layout_marginTop="10dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSendEncrypted"
                    android:layout_width="match_parent" android:layout_height="56dp" android:text="🔒 Envoyer via DATA SMS chiffré"
                    android:layout_marginTop="14dp" style="@style/Widget.Material3.Button" app:cornerRadius="18dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:text="HISTORIQUE" android:textColor="#666" android:textSize="11sp" android:layout_marginTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:id="@+id/historyContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
    </LinearLayout>
</FrameLayout>
