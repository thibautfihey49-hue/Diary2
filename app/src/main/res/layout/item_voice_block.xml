<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#2A2A3A"
    android:padding="10dp" android:layout_marginTop="6dp" android:gravity="center_vertical">
    <TextView android:id="@+id/btnPlay" android:layout_width="32dp" android:layout_height="32dp"
        android:background="#9C27B0" android:text="▶" android:gravity="center" android:textColor="#FFF"/>
    <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="3dp"
        android:background="#FF69B4" android:layout_marginHorizontal="10dp"/>
    <TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0:12" android:textColor="#AAAAAA" android:textSize="11sp"/>
</LinearLayout>
