<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp" android:background="#121212">
    <TextView android:id="@+id/logoMoon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🌙 HUNTR/X JOURNAL ADULTE 18+" android:textColor="#FFD700" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Fan-made - Appui long lune = coffre privé DATA SMS" android:textColor="#AAAAAA" android:textSize="11sp"/>
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/entryText"
        android:layout_width="match_parent" android:layout_height="150dp"
        android:hint="Ton entrée secrète..." android:textColor="#FFFFFF" android:layout_marginTop="16dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
        <Button android:id="@+id/btnImage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Image"/>
        <Button android:id="@+id/btnVoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Voix" android:layout_marginStart="8dp"/>
        <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sauver" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COFFRE PRIVE ADULTE - DATA SMS port 8090" android:textColor="#FF69B4" android:textStyle="bold"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <EditText android:id="@+id/vaultDest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Numéro destinataire" android:inputType="phone" android:textColor="#FFF"/>
        <EditText android:id="@+id/vaultMsg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Message chiffré" android:textColor="#FFF" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <Button android:id="@+id/btnSendVault" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Envoyer via DATA SMS chiffré" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="12sp" android:layout_marginTop="12dp"/>
</LinearLayout>
