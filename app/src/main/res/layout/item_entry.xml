<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="#9915151F" app:strokeWidth="1dp" app:strokeColor="#1AFFFFFF" app:cardElevation="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#888" android:textSize="11sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteEntry" android:layout_width="32dp" android:layout_height="32dp"
                android:text="✕" android:textSize="14sp" style="@style/Widget.Material3.Button.IconButton" android:insetTop="0dp" android:insetBottom="0dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF" android:textSize="14sp" android:layout_marginTop="8dp"/>
        <LinearLayout android:id="@+id/entryImages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <LinearLayout android:id="@+id/entryVoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
